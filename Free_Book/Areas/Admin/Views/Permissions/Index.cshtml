@using static Domain.Entity.Helper
@model PermissionViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>الاذونات</h1>

<br />
<div class="card">
    <div id="viewAll" class="card-body table-responsive">
        <form asp-controller="Permissions" asp-action="Update" method="post" class="d-inline">
            <input asp-for="@Model.RoleId" type="hidden" />
            <table class="table table-striped" id="permissionTable">
                <thead id="tablePermission">
                    <tr>

                        <th>
                            أسم الصلاحية
                        </th>
                        <th>
                            العمليات
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Enum.GetValues(typeof(PermissionModuleName)))
                    {
                        <tr>

                            @switch (@item.ToString())
                            {
                                case "Home":
                                    <td>لوحة التحكم</td>
                                    break;
                                case "Accounts":
                                    <td>حسابات المستخدمين</td>
                                    break;
                                case "Roles":
                                    <td>محموعة المستخدمين</td>
                                    break;
                                case "Registers":
                                    <td>المستخدمين</td>
                                    break;
                                case "Categories":
                                    <td>الفئات</td>
                                    break;
                                default:
                                    break;
                            }
                            @for (int i = 0; i < Model.roleClaims.Count(); i++)
                            {
                                if (@Model.roleClaims[i].Value.Split('.')[1] == item.ToString())
                                {
                                    <td>
                                        <input asp-for="@Model.roleClaims[i].Value" type="hidden" />
                                        @Model.roleClaims[i].Value.Split('.')[2]
                                    </td>
                                    <td>
                                        <div class="form-check m-1">
                                            <input asp-for="@Model.roleClaims[i].Selected" class="form-check-input" />
                                        </div>
                                    </td>
                                }
                            }
                        </tr>

                    }
                </tbody>
            </table>
            <div class="col-sm-12" style="padding: 20px 20px 0px 0px">
                <button type="submit" id="save" class="btn btn-success">
                    <i class="fa fa-check"></i>
                    Save
                </button>
                
                <a  asp-action="Roles" asp-controller="Accounts" asp-all-route-RoleId="@Model.RoleId" class="btn btn-secondary">
                    Back
                </a>
          
            </div>
        </form>
    </div>
</div>


