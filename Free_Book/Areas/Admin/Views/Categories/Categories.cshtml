@model CategoryViewModel
@inject UserManager<ApplicationUser> userManager
@{
    ViewData["Title"] = "Categories";
}

<style>
    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons that are used to open the tab content */
        .tab button {
            background-color: inherit;
            float: right;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
    }
</style>


<div class="wrapper">
    <!--Content-Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6 ">
                    <h1 class="text-dark ">@ResourceBook.LableCategories</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item active"><a href="/Admin/Home/Index">@ResourceBook.LableHomePage</a></li>
                        <li class="breadcrumb-item ">@ResourceBook.LableMangeBook</li>
                    </ol>
                </div>
            </div>
        </div> 
    </div>
    <!--End Content-Header-->
    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h1 class="card-title">@ResourceBook.LableCategories</h1>

                        <div class="card-tools">
                            <!-- Button trigger modal -->
                            <button type="button" class="btn btn-outline-info rounded-pill" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                                @ResourceBook.btnSaveNewCategories
                            </button>
                        </div>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">

                        <!-- Tab links -->
                        <div class="tab">
                            <button class="tablinks" onclick="openCity(event, 'Categories')" id="defaultOpen" >@ResourceBook.LableCategories</button>
                            <button class="tablinks" onclick="openCity(event, 'LogCategories')">@ResourceBook.LableLogCategories</button>
                          
                        </div> 

                        <!-- Tab content -->
                        <div id="Categories" class="tabcontent">

                            <table id="tableCategory" class="table table-bordered table-hover text-center">
                                <thead>
                                    <tr>
                                        <td>@ResourceBook.LableNameCategory</td>
                                        <td>@ResourceBook.LableDescription</td>
                                        <td>@ResourceBook.InEvents</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.categories)
                                    {
                                        <tr>
                                            <td style="font-size:30px">
                                              @item.Name
                                            </td>
                                            <td>@item.Description</td>
                                            <td>
                                                <input type="button" class="btn btn-info" onclick="Edit('@item.Id','@item.Name','@item.Description')" value="@ResourceBook.btnEdit" data-bs-toggle="modal" data-bs-target="#exampleModal" />
                                                <span>  |  </span>
                                                <input type="button" class="btn btn-danger" onclick="Delete('@item.Id')" value="@ResourceBook.btnDelete" data-bs-toggle="modal" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div 

                        <div id="LogCategories" class="tabcontent">
                            <table id="tableLogCategory" class="table table-bordered table-hover text-center">
                                <thead>
                                    <tr>
                                        <td>#</td>
                                        <td>@ResourceBook.LableNameCategory</td>
                                        <td>@ResourceBook.LableActionName</td>
                                        <td>@ResourceBook.LableDate</td>
                                        <td>@ResourceBook.LableUserName</td>
                                        <td>@ResourceBook.InEvents</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LogCategories)
                                    {
                                        <tr>
                                            <td>#</td>
                                            <td>
                                              @item.Category.Name
                                            </td>
                                            <td>

                                                @switch (@item.Action)
                                                {
                                                    case "Save":
                                                        <span class="badge badge-success " style="width:80%; ">@item.Action</span>
                                                        break;
                                                    case "Update":
                                                        <span class="badge badge-warning" style="width:80%; ">@item.Action</span>
                                                        break;
                                                    default:
                                                        <span class="badge badge-danger" style="width:80%;">@item.Action</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@item.Date</td>
                                            <td>@userManager.FindByIdAsync(item.UserId.ToString()).Result?.Name</td>
                                            <td>

                                               
                                                <input type="button" class="btn btn-danger" onclick="DeleteLog('@item.Id')" value="@ResourceBook.btnDelete" data-bs-toggle="modal" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                            
                        </div>

                        
                      
                    </div>


                    <!-- /.card-body -->
                </div>
                <!-- /.card -->

            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    <!-- /.content -->
    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="title">@ResourceBook.btnSaveNewCategories</h1>
                    <button type="button" class="btn btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="Save" asp-controller="Categories" method="post">
                        <div class="form-group">
                            <input type="text" hidden class="form-control" asp-for="NewCategory.Id" id="categoryId" />

                            <label asp-for="NewCategory.Name" class="control-label">@ResourceBook.LableCategoryName</label>
                            <input type="text" class="form-control" asp-for="NewCategory.Name" id="categoryName" />
                            <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="NewCategory.Description" class="control-label">@ResourceBook.LableDescription</label>
                            <input type="text" class="form-control" asp-for="NewCategory.Description" id="categoryDescription" />
                            <span asp-validation-for="NewCategory.Description" class="text-danger"></span>
                        </div>
                        <div class="modal-footer">
                            <input type="submit" class="btn btn-success" value="@ResourceBook.btnSaveNewRole" id="btnSave" />
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>


@section Script {

    @if (!string.IsNullOrEmpty(Context.Session.GetString("msgType")))
    {
        if (Context.Session.GetString("msgType") == "Success")
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString("title")',
                    text: '@Html.Raw(@Context.Session.GetString("msg"))',
                    icon: 'success'
                });
            </script>

        }
        else
        {
            <script>
                Swal.fire({
                    title: '@Context.Session.GetString("title")',
                    text: '@Html.Raw(@Context.Session.GetString("msg"))',
                    icon: 'error'
                });
            </script>
        }
        Context.Session.SetString("msgType", "");
    }


    <script src="~/Models/Categories.js"></script>
}






